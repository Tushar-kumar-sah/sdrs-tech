# ==============================================================================
# SDRS Tech — Production Server Configuration (.htaccess for LiteSpeed / Apache)
# ==============================================================================

# 1. CHARACTER ENCODING
AddDefaultCharset UTF-8

# 2. CANONICAL REDIRECTIONS (HTTPS & Non-WWW)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirect HTTP to HTTPS
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^(.*)$ https://sdrstech.in/$1 [R=301,L]

    # Redirect WWW to Non-WWW
    RewriteCond %{HTTP_HOST} ^www\.sdrstech\.in$ [NC]
    RewriteRule ^(.*)$ https://sdrstech.in/$1 [R=301,L]
</IfModule>

# 3. MIME TYPES
<IfModule mod_mime.c>
    AddType text/plain .txt
    AddType application/xml .xml
    AddType image/svg+xml .svg .svgz
    AddType image/webp .webp
    AddType video/mp4 .mp4
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# 4. SECURITY HEADERS
<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Clickjacking protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Referrer policy for privacy and tracking
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Cross-Origin Opener Policy
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>

# 5. BROWSER CACHING (Performance & Core Web Vitals)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML (keep fresh for metadata updates)
    ExpiresByType text/html "access plus 1 hour"

    # Data / Feeds
    ExpiresByType text/plain "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
    ExpiresByType application/json "access plus 0 seconds"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Images & Media
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"

    # Web Fonts
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. CACHE-CONTROL HEADERS
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg|ico|mp4|woff2)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, public, must-revalidate"
    </FilesMatch>
    <FilesMatch "sitemap\.xml$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
    <FilesMatch "robots\.txt$">
        Header set Cache-Control "max-age=86400, public"
    </FilesMatch>
</IfModule>

# 7. PROTECT SENSITIVE FILES
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
<FilesMatch "\.(zip|tar|gz|bak|config|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>
